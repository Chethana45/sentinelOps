# =============================================================================
# SentinelOps — Environment Variables
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file:   cp .env.example .env
#   2. Edit .env and fill in real values.
#   3. NEVER commit .env to Git — it is already in .gitignore.
#   4. All variables below are read by docker-compose.yml automatically.
#
# Docker Compose reads .env from the same directory as docker-compose.yml.
# Variables are substituted wherever ${VARIABLE_NAME} appears.
# =============================================================================

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------
# Sets the Docker Compose project name (prefix for container/network names).
COMPOSE_PROJECT_NAME=sentinelops

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
# Admin login credentials for the Grafana web UI.
# Change GRAFANA_ADMIN_PASSWORD to a strong password before going to production.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Host port Grafana listens on (browser: http://localhost:3000)
GRAFANA_PORT=3000

# ---------------------------------------------------------------------------
# Prometheus
# ---------------------------------------------------------------------------
# Host port Prometheus listens on (browser: http://localhost:9090)
PROMETHEUS_PORT=9090

# How long Prometheus keeps metrics data (e.g. 15d, 30d, 6h)
PROMETHEUS_RETENTION_TIME=15d

# ---------------------------------------------------------------------------
# Alertmanager
# ---------------------------------------------------------------------------
# Host port Alertmanager listens on (browser: http://localhost:9093)
ALERTMANAGER_PORT=9093

# ---------------------------------------------------------------------------
# Node Exporter
# ---------------------------------------------------------------------------
# Host port Node Exporter metrics endpoint (http://localhost:9100/metrics)
NODE_EXPORTER_PORT=9100

# ---------------------------------------------------------------------------
# SMTP / Email Alerts  (OPTIONAL — leave blank to disable email alerting)
# ---------------------------------------------------------------------------
# If left empty, Alertmanager operates with local webhook routing only.
# To enable email alerts:
#   1. Set the SMTP parameters below.
#   2. Run: bash scripts/generate_alertmanager_config.sh
#   3. Reload: curl -X POST http://localhost:9093/-/reload
#
# Example for Gmail (requires an App Password — not your main account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx   <- 16-character App Password
#   SMTP_FROM=you@gmail.com
#   ALERT_EMAIL_TO=oncall@yourcompany.com
#
# Example for generic SMTP server:
#   SMTP_HOST=smtp.mailgun.org (or smtp.office365.com, etc.)
#   SMTP_PORT=587
#   SMTP_USERNAME=postmaster@yourdomain.com
#   SMTP_PASSWORD=your_smtp_password
#   SMTP_FROM=alerts@yourdomain.com
#   ALERT_EMAIL_TO=team@yourdomain.com

ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Slack Alerts  (OPTIONAL — leave blank to disable)
# ---------------------------------------------------------------------------
# Paste your Slack incoming webhook URL here to enable Slack notifications.
# Generate one at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#alerts
